@model WebApp.Models.Dtos.Equipo.EquipoAltaDto

@{
    ViewData["Title"] = "Crear Equipo";
}

<div class="container mt-5">

    <h2 class="mb-4">Alta de Equipo</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <form asp-action="Create" method="post" id="formEquipo">

        <!-- TIPO EQUIPO -->
        <div class="mb-3">
            <label>Tipo de Equipo</label>
            <select id="tipoEquipo" name="tipoEquipo" class="form-select" required>
                <option value="" selected disabled>Seleccione equipo</option>
                <option value="Camara">Cámara</option>
                <option value="Montura">Montura</option>
                <option value="Ocular">Ocular</option>
                <option value="Telescopio">Telescopio</option>
            </select>
        </div>

        <!-- BASE -->
        <div class="mb-3">
            <label>Marca</label>
            <input name="marca" class="form-control" required />
        </div>

        <div class="mb-3">
            <label>Modelo</label>
            <input name="modelo" class="form-control" required />
        </div>

        <div class="mb-3">
            <label>Cantidad disponible</label>
            <input type="number" name="cantidadDisponible" class="form-control" required min="1" />
        </div>

        <!-- CAMARA -->
        <div id="camaraFields" style="display:none;">
            <div class="mb-3">
                <label>Tipo Sensor</label>
                <select name="tipoSensor" class="form-select">
                    <option value="">Seleccione tipo de sensor</option>
                    <option value="CCD">CCD</option>
                    <option value="CMOS">CMOS</option>
                </select>
            </div>

            <div class="mb-3">
                <label>Resolución</label>
                <input name="resolucion" class="form-control" />
                <small class="text-muted">Ej: 6000x4000</small>
            </div>

            <div class="mb-3">
                <label>Tamaño pixel (micras)</label>
                <input type="number" step="0.01" name="tamanioPixelMicras" class="form-control" />
                <small class="text-muted">Ej: 4.63</small>
            </div>
        </div>

        <!-- MONTURA -->
        <div id="monturaFields" style="display:none;">
            <div class="mb-3">
                <label>Tipo Montura</label>
                <select name="tipoMontura" class="form-select">
                    <option value="">Seleccione tipo de montura</option>
                    <option value="Ecuatorial">Ecuatorial</option>
                    <option value="AltAzimutal">AltAzimutal</option>
                    <option value="Hibrida">Hibrida</option>
                </select>
            </div>

            <div class="mb-3">
                <label>Carga útil (Kg)</label>
                <input type="number" step="0.01" name="cargaUtilKg" class="form-control" />
                <small class="text-muted">Ej: 5.5</small>
            </div>

            <input type="hidden" name="esGoTo" value="false" />

            <input type="checkbox"
                   name="esGoTo"
                   value="true"
                   class="form-check-input" />

            <label class="form-check-label">Es GoTo</label>
        </div>

        <!-- OCULAR -->
        <div id="ocularFields" style="display:none;">
            <div class="mb-3">
                <label>Diámetro (mm)</label>
                <input type="number" step="0.01" name="diametroMM" class="form-control" />
                <small class="text-muted">Ej: 25</small>
            </div>

            <div class="mb-3">
                <label>Ángulo de visión (grados)</label>
                <input type="number" step="0.01" name="anguloVisionGrados" class="form-control" />
                <small class="text-muted">Ej: 60</small>
            </div>
        </div>

        <!-- TELESCOPIO -->
        <div id="telescopioFields" style="display:none;">
            <div class="mb-3">
                <label>Apertura (mm)</label>
                <input type="number" step="0.01" name="aperturaMM" class="form-control" />
                <small class="text-muted">Ej: 150</small>
            </div>

            <div class="mb-3">
                <label>Relación focal</label>
                <input name="relacionFocal" class="form-control" />
                <small class="text-muted">Ej: f/10, f/5, f/11.5</small>
            </div>

            <div class="mb-3">
                <label>Distancia focal (mm)</label>
                <input type="number" step="0.01" name="distanciaFocalMM" class="form-control" />
                <small class="text-muted">Ej: 750</small>
            </div>

            <div class="mb-3">
                <label>Peso (kg)</label>
                <input type="number" step="0.01" name="pesoKg" class="form-control" />
                <small class="text-muted">Ej: 3.2</small>
            </div>
        </div>

        <!-- BOTONES -->
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Crear</button>

            <a asp-controller="Equipo"
               asp-action="Index"
               class="btn btn-secondary">Volver</a>
        </div>

    </form>
</div>

<script>
    const tipo = document.getElementById("tipoEquipo");

    const campos = {
        Camara: document.getElementById("camaraFields"),
        Montura: document.getElementById("monturaFields"),
        Ocular: document.getElementById("ocularFields"),
        Telescopio: document.getElementById("telescopioFields")
    };

    function ocultarTodo() {
        Object.values(campos).forEach(c => c.style.display = "none");
    }

    tipo.addEventListener("change", function () {
        ocultarTodo();
        if (campos[this.value]) {
            campos[this.value].style.display = "block";
        }
    });

    ocultarTodo();

    document.getElementById("formEquipo").addEventListener("submit", function (e) {

        const tipo = document.getElementById("tipoEquipo").value;

        const visible = campos[tipo];

        if (!visible) return;

        const inputs = visible.querySelectorAll("input, select");

        for (let input of inputs) {
            if (!input.value) {
                e.preventDefault();
                alert("Complete todos los campos del tipo seleccionado");
                return;
            }
        }
    });
</script>